{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astra-vital.example/schemas/telemetry-event.json",
  "title": "TelemetryEvent",
  "type": "object",
  "required": [
    "event_id",
    "mission_id",
    "astronaut_id",
    "timestamp",
    "source_node",
    "source_sensor",
    "measurement",
    "quality",
    "priority"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "astronaut_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source_node": { "type": "string" },
    "source_sensor": { "type": "string" },
    "measurement": {
      "type": "object",
      "required": ["type", "value", "unit"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["confidence", "error_margin", "signal_quality"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "error_margin": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_quality": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "P4"] }
  }
}